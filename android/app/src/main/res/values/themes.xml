<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar, and the same ground colour as the scoreboard so there is
         no pale flash between launch and first paint. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
    </style>
</resources>

{
  "name": "Padel Scoreboard",
  "short_name": "Padel",
  "description": "Courtside padel scoreboard scored from a D10 remote.",
  "start_url": "./",
  "scope": "./",
  "id": "d10-padel-scoreboard",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
